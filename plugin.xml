<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <class>org.jivesoftware.openfire.mediaproxy.RTPBridgePlugin</class>

    <name>${project.name}</name>
    <description>${project.description}</description>
    <author>${project.developers[0].name}</author>
    <licenseType>apache</licenseType>
    <version>${project.version}</version>
    <date>2026-10-19</date>
    <minServerVersion>5.2.0</minServerVersion>

    <adminconsole>
        <tab id="tab-server">
            <sidebar id="sidebar-media-services">
                <item id="media-proxy-service" name="${sidebar.media-proxy}"
                      url="media-proxy.jsp"
                      description="${sidebar.media-proxy.descr}"/>
            </sidebar>
        </tab>
    </adminconsole>
</plugin>
